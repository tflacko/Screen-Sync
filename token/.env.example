# Copy to token/.env (already gitignored) and fill in. Never commit real
# values — this file only documents which variables the scripts read.

# devnet | mainnet — defaults to devnet if unset.
SSC_NETWORK=devnet

# Optional RPC overrides.
SSC_DEVNET_RPC_URL=https://api.devnet.solana.com
SSC_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Path to a local Solana CLI JSON keypair file. Devnet only — for mainnet,
# sign with a hardware wallet (Ledger) instead of a plaintext file.
WALLET_KEYPAIR_PATH=~/.config/solana/id.json

# Must be set to exactly "yes" to allow SSC_NETWORK=mainnet to run.
# Deliberate speed bump before any script can touch mainnet.
SSC_CONFIRM_MAINNET=no
